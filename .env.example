API_KEY=默认使用通义千问,apikey通过百炼模型平台获取
COOKIES_STR=your_cookies_here
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-max
# 意图分类专用模型（仅builtin后端）：分类是纯判别任务，建议配小模型压时延；留空则用MODEL_NAME
CLASSIFY_MODEL_NAME=qwen-turbo
TOGGLE_KEYWORDS=。
SIMULATE_HUMAN_TYPING=False

# 设备ID：首次启动自动生成并写回此项；固定后重启复用，避免"每次重启都是新设备"的风控特征。留空=自动生成
DEVICE_ID=
# Token刷新时间抖动上限（秒）：在TOKEN_REFRESH_INTERVAL基础上叠加0~该值的随机量，打散整点刷新节奏
TOKEN_REFRESH_JITTER=600
# 撞风控(RGV587)后、无交互终端下退出前的冷却秒数。配合 docker restart:always 拉开重试间隔，
# 避免"崩溃→秒重启→再戳风控"的循环把账号一直摁在风控状态。默认30分钟
RISK_COOLDOWN=1800
# TLS指纹模拟目标（curl_cffi）：默认chrome。装不了curl_cffi会自动回退requests（风控概率高）
IMPERSONATE=chrome
# token 来源：http（curl_cffi 直连 mtop，默认）/ browser（容器内无头真实Chromium取token，需Playwright镜像）
# 账号被风控点名、http 一直 RGV587 时，改成 browser 让页面自己那套风控JS去取token
TOKEN_PROVIDER=http
# browser 模式下每次取 token 的等待上限（秒）
BROWSER_TOKEN_TIMEOUT=60

# 回复后端：builtin（内置多Agent，默认）/ coze（直接转发给Coze bot）
REPLY_BACKEND=coze
# 以下仅 REPLY_BACKEND=coze 时需要；bot prompt 里可用 {{item_info}} 和 {{bargain_count}} 占位符
COZE_API_TOKEN=
COZE_BOT_ID=
COZE_BASE_URL=https://api.coze.cn